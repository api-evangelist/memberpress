{
  "opencollection": "1.0.0",
  "info": {
    "name": "MemberPress Developer Tools REST API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "MEMBERPRESS-API-KEY",
      "value": "{{MEMBERPRESS-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify authentication",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/mp/v1/me"
          },
          "docs": "Verifies that the supplied API key is valid and returns basic information about the authenticated user. Documented response: `{\"success\": true, \"data\": {\"username\": \"admin\"}}`."
        },
        {
          "info": {
            "name": "Get user permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/mp/v1/me/permissions"
          },
          "docs": "Returns the permissions of the authenticated user."
        }
      ]
    },
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/mp/v1/members",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Items per page."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "General search term."
              },
              {
                "name": "orderby",
                "value": "",
                "type": "query",
                "description": "Field to order results by."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort direction (ASC or DESC)."
              },
              {
                "name": "search[id]",
                "value": "",
                "type": "query",
                "description": "Search by member ID."
              },
              {
                "name": "search[email]",
                "value": "",
                "type": "query",
                "description": "Search by email address."
              },
              {
                "name": "search[username]",
                "value": "",
                "type": "query",
                "description": "Search by username."
              }
            ]
          },
          "docs": "Lists all members (WordPress users) known to MemberPress."
        },
        {
          "info": {
            "name": "Create member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{site}/wp-json/mp/v1/members",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new member. `email` and `username` are required."
        },
        {
          "info": {
            "name": "Get member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/mp/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Member ID."
              }
            ]
          },
          "docs": "Gets a specific member by ID."
        },
        {
          "info": {
            "name": "Update member",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{site}/wp-json/mp/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Member ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing member. Accepts the same fields as create, except `password`."
        },
        {
          "info": {
            "name": "Delete member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{site}/wp-json/mp/v1/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Member ID."
              }
            ]
          },
          "docs": "Deletes a member. MemberPress documents this as destructive — use with caution."
        },
        {
          "info": {
            "name": "Get member options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/mp/v1/member_options"
          },
          "docs": "Returns the available options for members (roles and similar)."
        }
      ]
    },
